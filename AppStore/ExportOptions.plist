<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode 15.3 and later; older Xcode called this "app-store". -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>CU24N2K7KY</string>
	<!-- The App Store Connect API key lets Xcode make the distribution
	     certificate and profile itself, so none are kept in the repository. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
